# El Reino API Environment Configuration

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/netDB
MONGODB_URI_PROD=mongodb://your-production-url/netDB

# Server Configuration
PORT=3100
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE=5MB
UPLOAD_PATH=./uploads

# CORS Configuration
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PROD=https://el-reino-app.vercel.app

# Security
BCRYPT_ROUNDS=10